<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:padding="16dp">

    <!-- Connection Status -->
    <TextView
        android:id="@+id/connectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connecting..."
        android:textColor="#4ecca3"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/connectionIndicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_dialog_alert"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/connectionLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- IP Input -->
    <EditText
        android:id="@+id/ipInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="IP Address (e.g., 192.168.1.100)"
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/connectionIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Port Input -->
    <EditText
        android:id="@+id/portInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Port (e.g., 11434)"
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"
        android:inputType="number"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/ipInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Model Selector Dropdown -->
    <Spinner
        android:id="@+id/modelSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:drawable/btn_dropdown"
        android:popupBackground="#2d2d44"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/portInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- System Prompt -->
    <EditText
        android:id="@+id/promptInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="System Prompt / Temperature"
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:minHeight="80dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/modelSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Send Button -->
    <Button
        android:id="@+id/sendButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Send"
        android:background="@drawable/btn_send"
        android:textColor="#ffffff"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/promptInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Chat Display -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#16213e"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/sendButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/menuButton">

        <TextView
            android:id="@+id/chatDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#e0e0e0"
            android:textSize="14sp"
            android:padding="8dp"
            android:fontFamily="monospace"/>
    </ScrollView>

    <!-- Menu Button -->
    <ImageView
        android:id="@+id/menuButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_add"
        android:background="@drawable/circle_background"
        app:tint="#4ecca3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"/>

    <!-- Chat List Button -->
    <ImageView
        android:id="@+id/chatListButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_my_calendar"
        android:background="@drawable/circle_background"
        app:tint="#4ecca3"
        app:layout_constraintBottom_toBottomOf="@id/menuButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/menuButton"
        app:layout_constraintHorizontal_chainStyle="spread"/>

    <!-- Model Selector Button -->
    <ImageView
        android:id="@+id/modelSelectorButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:background="@drawable/circle_background"
        app:tint="#4ecca3"
        app:layout_constraintBottom_toBottomOf="@id/menuButton"
        app:layout_constraintStart_toStartOf="@id/menuButton"
        app:layout_constraintEnd_toStartOf="@id/menuButton"
        app:layout_constraintHorizontal_chainStyle="spread"/>

    <!-- Settings Button -->
    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:background="@drawable/circle_background"
        app:tint="#4ecca3"
        app:layout_constraintBottom_toBottomOf="@id/menuButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/menuButton"
        app:layout_constraintHorizontal_chainStyle="spread"/>

    <!-- Voice Button -->
    <ImageView
        android:id="@+id/voiceButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_dialog_audio"
        android:background="@drawable/circle_background"
        app:tint="#4ecca3"
        app:layout_constraintBottom_toBottomOf="@id/menuButton"
        app:layout_constraintEnd_toEndOf="@id/settingsButton"
        app:layout_constraintStart_toEndOf="@id/settingsButton"
        app:layout_constraintHorizontal_chainStyle="spread"/>

    <!-- File Button -->
    <ImageView
        android:id="@+id/fileButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:background="@drawable/circle_background"
        app:tint="#4ecca3"
        app:layout_constraintBottom_toBottomOf="@id/menuButton"
        app:layout_constraintEnd_toEndOf="@id/voiceButton"
        app:layout_constraintStart_toEndOf="@id/voiceButton"
        app:layout_constraintHorizontal_chainStyle="spread"/>

    <!-- Export Button -->
    <ImageView
        android:id="@+id/exportButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_send"
        android:background="@drawable/circle_background"
        app:tint="#4ecca3"
        app:layout_constraintBottom_toBottomOf="@id/menuButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fileButton"/>

</androidx.constraintlayout.widget.ConstraintLayout>
