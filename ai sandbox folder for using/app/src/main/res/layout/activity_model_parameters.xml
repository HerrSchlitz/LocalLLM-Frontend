<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Model Parameters"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Top P (Nucleus Sampling):"
        android:textSize="16sp"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderTopP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="1.0"
        android:value="0.9"
        android:stepSize="0.1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Top K:"
        android:textSize="16sp"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderTopK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="1024"
        android:value="40"
        android:stepSize="1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeat Penalty:"
        android:textSize="16sp"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderRepeatPenalty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1.0"
        android:valueTo="2.0"
        android:value="1.1"
        android:stepSize="0.1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Presence Penalty:"
        android:textSize="16sp"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPresencePenalty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="2.0"
        android:value="0.0"
        android:stepSize="0.1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Frequency Penalty:"
        android:textSize="16sp"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderFrequencyPenalty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="2.0"
        android:value="0.0"
        android:stepSize="0.1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seed:"
        android:textSize="16sp"/>
    <EditText
        android:id="@+id/editSeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="-1 (random)"
        android:inputType="number"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Num GPU (0 = CPU only):"
        android:textSize="16sp"/>
    <EditText
        android:id="@+id/editNumGPU"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0"
        android:inputType="number"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Num Thread:"
        android:textSize="16sp"/>
    <EditText
        android:id="@+id/editNumThread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0 (auto)"
        android:inputType="number"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Context Length:"
        android:textSize="16sp"/>
    <EditText
        android:id="@+id/editContextLength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="2048"
        android:inputType="number"/>

    <Button
        android:id="@+id/btnResetDefaults"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset to Defaults"/>

</LinearLayout>
